{
  "manifest_version": 3,
  "name": "AetherChat - Universal AI Stealth Camouflage",
  "version": "1.1.0",
  "description": "Transforms Instagram, WhatsApp Web, Telegram, Discord, X/Twitter, Messenger, Slack and any chat interface into a 1:1 replica of Gemini, ChatGPT, or Claude with real-time stealth multimedia bridging.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://web.whatsapp.com/*",
    "https://web.telegram.org/*",
    "https://discord.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.messenger.com/*",
    "https://*.facebook.com/messages/*",
    "https://app.slack.com/*",
    "https://*.reddit.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://web.whatsapp.com/*",
        "https://web.telegram.org/*",
        "https://discord.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.messenger.com/*",
        "https://*.facebook.com/messages/*",
        "https://app.slack.com/*",
        "https://*.reddit.com/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*"
      ],
      "js": [
        "core/obfuscator.js",
        "core/hotkeys.js",
        "bridge/media_handler.js",
        "bridge/universal_bridge.js",
        "bridge/instagram_bridge.js",
        "ui/overlay.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "AetherChat Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "themes/*",
        "ui/*",
        "bridge/*",
        "core/*",
        "icons/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
